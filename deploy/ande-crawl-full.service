[Unit]
Description=Ande weekly full crawl (re-fetch every detail)
After=network-online.target

[Service]
Type=oneshot
User=ande
WorkingDirectory=/opt/ande
ExecStart=/opt/ande/deploy/crawl.sh --full
# 采集结束后，数据有更新才重启服务让它加载（前面带 + 表示以 root 身份执行）；一轮什么都没发布则不重启。
ExecStopPost=+/opt/ande/deploy/reload.sh
# 采集（含 Chrome）整体限制在 1000M 内，超了只杀采集；并发 2 以适应 1.6G 内存。
MemoryMax=1000M
OOMScoreAdjust=500
Environment=ANDE_CONCURRENCY=2 CHROME_PATH=/usr/local/bin/chrome-ns
TimeoutStartSec=4h
